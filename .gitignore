# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 캡쳐 샘플 — 빌드에 필요 없는 바이너리.
# 파싱 계약은 src/lib/extract/okx.test.ts 의 텍스트 픽스처가 고정한다.
IMG/

.vercel

# 백테스트 캔들 캐시 — 수 MB 원시 데이터, 재수집 가능.
scripts/backtest/.cache/
backtest-lab/.cache/
# 실험 결과물 — 원재료 JSON 만 38MB. 스크립트를 다시 돌리면 나온다.
backtest-lab/out/

# 복기 시스템 로컬 데이터 — OKX 재수집·재생성 가능.
re_sys/data/
re_sys/out/

# 시스템 트레이딩 런타임 데이터 — 로컬에 쌓인다. 스냅샷 커밋은 의도적으로만.
system-trading/data/*
!system-trading/data/.gitkeep
# 위의 .env* 전역 패턴이 키 양식 파일까지 삼키지 않게 한다.
!system-trading/bot/.env.example

# 요청 백로그 — 로컬 작업 지시서. 이력은 이 머신에만 둔다.
.backlog/

# DB 스냅샷 백업 — 개인 매매 데이터. 되돌리기용 로컬 보관.
/backups/
