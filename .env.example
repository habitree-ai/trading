# Supabase — 대시보드 > Project Settings > API
# publishable 키는 브라우저로 나가는 공개 키다. secret/service_role 키는 절대 여기 넣지 말 것.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 서버 전용 secret 키 — 거래소 동기화의 필수 항목이다.
# 거래소 API 키는 Supabase Vault 에 암호화되어 있고, 복호화는 service_role 에게만 열려 있다.
# 이 키가 없으면 "OKX 동기화" 버튼도 크론도 키를 읽지 못한다.
# 브라우저로 나가는 코드에서는 절대 참조하지 말 것.
SUPABASE_SECRET_KEY=

# 앱을 쓸 수 있는 계정 — 쉼표로 구분.
# 비워 두면 구글 계정이 있는 누구나 들어온다. 배포 환경에는 반드시 채울 것.
ALLOWED_EMAILS=cdhrich@gmail.com

# 캡쳐 AI 비전 폴백 (M3) — 서버에서만 사용
AI_GATEWAY_API_KEY=

# 매일 자동 동기화(선택) — CRON_SECRET 과 SUPABASE_SECRET_KEY 가 있어야
# /api/cron/okx-sync 가 동작한다. 손으로 누르는 "OKX 동기화" 버튼만 쓸 거라면 비워 둬도 된다.
CRON_SECRET=

# OKX 거래내역 동기화 키는 더 이상 환경변수가 아니다.
# 앱의 [설정] 화면에서 계정마다 등록하면 Supabase Vault 가 암호화해 보관한다.
# 반드시 "읽기 전용(Read)" 권한으로 발급할 것. 출금·거래 권한을 주면 안 된다.
#
# 예전 환경변수(OKX_API_KEY / OKX_API_SECRET / OKX_API_PASSPHRASE)를 옮기려면
# 마이그레이션 0010 적용 후 아래를 한 번 실행하고, 그다음 0011 을 적용한다.
#   npm run seed:okx-account

# ── 실주문 (배선 검증 화면 · /system/test) ────────────────────────────────
# 앱이 직접 주문을 내는 경로. 위의 Vault 키(읽기 전용 동기화)와는 다른 자격이고,
# 봇(system-trading)이 매매하는 계좌와 **같은 계좌**를 가리켜야 한다.
#
# 이름을 OKX_API_* 와 나눈 것은 2026-08-19 사고 때문이다. 봇은 로컬 PC 에서,
# 앱은 배포 서버에서 돈다 — 이름이 같으면 코드가 옳은 채로 실행 위치가 계좌를
# 정해 버린다. 실제로 배포된 실주문 버튼이 봇 서브계정이 아니라 주 매매계정을
# 향하고 있었고, 화면 어디에도 그 사실이 없었다.
#
# 폴백은 없다. 비어 있으면 배선 검증 화면이 닫힌다 — 조용히 다른 계좌로 흘러가느니
# 동작하지 않는 편이 낫다.
OKX_LIVE_API_KEY=
OKX_LIVE_API_SECRET=
OKX_LIVE_API_PASSPHRASE=

# ── 봇 (system-trading) ───────────────────────────────────────────────────
# 봇은 OKX_API_KEY / OKX_API_SECRET / OKX_API_PASSPHRASE 를 읽는다(로컬 실행 전용).
# 아래 uid 를 넣어 두면 키가 바뀌었을 때 사이클을 시작하지 않고 멈춘다.
# 비워 두면 경고만 남기고 계속 돈다.
OKX_EXPECTED_UID=

# 봇이 Supabase 에 상태를 쓸 때의 소유자 — service 키와 짝이다.
SYSTEM_BOT_USER_ID=

# ── 선배님 아카이브 공개 페이지 (/blog) ────────────────────────────────────
# 읽기는 누구나. 노트를 쓰고 고칠 수 있는 계정 — 쉼표로 구분.
# ALLOWED_EMAILS 와 달리 비워 두면 아무도 편집하지 못한다 — 공개 페이지라 "비면 전원"은 위험하다.
BLOG_ADMIN_EMAILS=cdhrich@gmail.com
